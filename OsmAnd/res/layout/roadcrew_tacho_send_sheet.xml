<?xml version="1.0" encoding="utf-8"?>
<!-- Send the DDD file: exactly two ways, e-mail and Viber (Galin, 25.09.2026). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/roadcrewTachoSendSheet"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingStart="20dp"
	android:paddingTop="12dp"
	android:paddingEnd="20dp"
	android:paddingBottom="28dp">

	<View
		android:id="@+id/roadcrewTachoSendHandle"
		android:layout_width="40dp"
		android:layout_height="5dp"
		android:layout_gravity="center_horizontal" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:text="@string/roadcrew_tacho_send_title"
		android:textColor="@color/roadcrew_tacho_text"
		android:textSize="19sp"
		android:textStyle="bold" />

	<TextView
		android:id="@+id/roadcrewTachoSendSubtitle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:textColor="@color/roadcrew_tacho_secondary"
		android:textSize="14sp" />

	<LinearLayout
		android:id="@+id/roadcrewTachoSendEmail"
		android:layout_width="match_parent"
		android:layout_height="72dp"
		android:layout_marginTop="14dp"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingEnd="16dp">

		<ImageView
			android:id="@+id/roadcrewTachoSendEmailIcon"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:importantForAccessibility="no"
			android:padding="10dp"
			android:src="@drawable/roadcrew_tacho_ic_mail" />

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="14dp"
			android:orientation="vertical">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/roadcrew_tacho_send_email"
				android:textColor="@color/roadcrew_tacho_text"
				android:textSize="18sp"
				android:textStyle="bold" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/roadcrew_tacho_send_email_detail"
				android:textColor="@color/roadcrew_tacho_secondary"
				android:textSize="13sp" />
		</LinearLayout>
	</LinearLayout>

	<LinearLayout
		android:id="@+id/roadcrewTachoSendViber"
		android:layout_width="match_parent"
		android:layout_height="72dp"
		android:layout_marginTop="12dp"
		android:clickable="true"
		android:focusable="true"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingStart="16dp"
		android:paddingEnd="16dp">

		<ImageView
			android:id="@+id/roadcrewTachoSendViberIcon"
			android:layout_width="44dp"
			android:layout_height="44dp"
			android:importantForAccessibility="no"
			android:padding="10dp"
			android:src="@drawable/roadcrew_tacho_ic_chat" />

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="14dp"
			android:orientation="vertical">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/roadcrew_tacho_send_viber"
				android:textColor="@color/roadcrew_tacho_text"
				android:textSize="18sp"
				android:textStyle="bold" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/roadcrew_tacho_send_viber_detail"
				android:textColor="@color/roadcrew_tacho_secondary"
				android:textSize="13sp" />
		</LinearLayout>
	</LinearLayout>

	<Button
		android:id="@+id/roadcrewTachoSendCancel"
		style="?android:attr/borderlessButtonStyle"
		android:layout_width="match_parent"
		android:layout_height="52dp"
		android:layout_marginTop="12dp"
		android:stateListAnimator="@null"
		android:text="@string/roadcrew_tacho_send_cancel"
		android:textAllCaps="false"
		android:textColor="@color/roadcrew_tacho_text"
		android:textSize="16sp" />
</LinearLayout>
